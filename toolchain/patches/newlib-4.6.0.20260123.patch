diff -rupN old/newlib/configure.host new/newlib/configure.host
--- old/newlib/configure.host	2026-01-24 06:12:49.000000000 +0800
+++ new/newlib/configure.host	2026-09-15 23:37:13.874002302 +0800
@@ -430,6 +430,26 @@ fi
 # THIS TABLE IS ALPHA SORTED.  KEEP IT THAT WAY.
 
 case "${host}" in
+  aarch64*-*-lyos* | arm*-*-lyos*)
+	sys_dir=lyos
+	have_crt0="no"
+	newlib_cflags="${newlib_cflags} -DMISSING_SYSCALL_NAMES -DSIGNAL_PROVIDED"
+	;;
+  i[34567]86-*-lyos*)
+	sys_dir=lyos
+	have_crt0="no"
+	newlib_cflags="${newlib_cflags} -D_NO_GETPWENT -D_I386MACH_NEED_SOTYPE_FUNCTION -DHAVE_MKDIR -DMISSING_SYSCALL_NAMES -DSIGNAL_PROVIDED"
+	;;
+  riscv*-*-lyos*)
+	sys_dir=lyos
+	have_crt0="no"
+	newlib_cflags="${newlib_cflags} -mcmodel=medany -DMISSING_SYSCALL_NAMES -DSIGNAL_PROVIDED"
+	;;
+  x86_64-*-lyos*)
+	sys_dir=lyos
+	have_crt0="no"
+	newlib_cflags="${newlib_cflags} -D_NO_GETPWENT -D_I386MACH_NEED_SOTYPE_FUNCTION -DHAVE_MKDIR -DMISSING_SYSCALL_NAMES -DSIGNAL_PROVIDED"
+	;;
   *-*-cygwin*)
 	posix_dir=posix
 	xdr_dir=xdr
@@ -897,6 +917,11 @@ newlib_cflags="${newlib_cflags} -DCLOCK_
 	;;
 esac
 
+# Lyos supplies its own syscall wrappers in newlib/libc/sys/lyos.
+case "${host}" in
+  *-*-lyos*) syscall_dir= ;;
+esac
+
 # Use defaults for certain settings if not specified by user
 
 # Enable C99 format support in I/O routines if requested.
